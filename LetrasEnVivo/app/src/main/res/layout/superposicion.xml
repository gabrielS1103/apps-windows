<?xml version="1.0" encoding="utf-8"?>
<!-- Ventana flotante. La parte contraída muestra la línea actual y la siguiente;
     al tocarla se despliega la lista completa (lista_lineas). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="@dimen/ancho_superposicion"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_superposicion"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <!-- Cabecera: canción + botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/texto_cabecera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/texto_aviso"
            android:textSize="11sp"
            tools:text="The Example Band – Paper Lanterns" />

        <ImageButton
            android:id="@+id/boton_expandir"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ajustes"
            android:src="@drawable/ic_expandir" />

        <ImageButton
            android:id="@+id/boton_ajustes"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ajustes"
            android:src="@drawable/ic_ajustes" />

        <ImageButton
            android:id="@+id/boton_cerrar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cerrar"
            android:src="@drawable/ic_cerrar" />
    </LinearLayout>

    <!-- Vista contraída -->
    <LinearLayout
        android:id="@+id/panel_contraido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/texto_original"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_original"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Paper lanterns over the river" />

        <TextView
            android:id="@+id/texto_traducido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_traducido"
            android:textSize="17sp"
            tools:text="Linternas de papel sobre el río" />

        <TextView
            android:id="@+id/texto_siguiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/texto_siguiente"
            android:textSize="13sp"
            tools:text="Drifting slowly into the night" />
    </LinearLayout>

    <!-- Vista expandida (toda la letra) -->
    <LinearLayout
        android:id="@+id/panel_expandido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/toca_para_sincronizar"
            android:textColor="@color/texto_aviso"
            android:textSize="11sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_lineas"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/boton_menos"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/menos_medio_segundo"
                android:textColor="@color/texto_original" />

            <TextView
                android:id="@+id/texto_desfase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/texto_aviso"
                android:textSize="12sp"
                tools:text="desfase 0,0 s" />

            <Button
                android:id="@+id/boton_mas"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/mas_medio_segundo"
                android:textColor="@color/texto_original" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/texto_aviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/texto_aviso"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="≈ tiempos aproximados"
        tools:visibility="visible" />
</LinearLayout>
